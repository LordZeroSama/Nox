#!/usr/bin/env bash
# Nox OS - boot-time performance tuning.
set -u

# CPU governor: "performance" keeps clocks high (better frame pacing on weak CPUs).
for gov_file in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [[ -w "$gov_file" ]] && echo performance > "$gov_file"
done

# Disk I/O: avoid needless writes on the (slow) USB disk.
for dev in /sys/block/sd*; do
    [[ -w "$dev/queue/read_ahead_kb" ]] && echo 2048 > "$dev/queue/read_ahead_kb"
done
exit 0
