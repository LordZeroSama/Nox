<?xml version="1.0"?>
<labwc_config>
  <core>
    <!-- Fewer effects, less latency -->
    <decoration>server</decoration>
    <gap>0</gap>
    <adaptiveSync>yes</adaptiveSync>
  </core>
  <theme>
    <cornerRadius>0</cornerRadius>
    <font><name>DejaVu Sans</name><size>10</size></font>
  </theme>
  <keyboard>
    <default />
    <!-- Super: back to the Nox home screen, Super+Space: app search -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="nox-home" /></keybind>
    <keybind key="W-space"><action name="Execute" command="fuzzel" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-r"><action name="Execute" command="nox-run flatpak run org.vinegarhq.Sober" /></keybind>
    <keybind key="W-m"><action name="Execute" command="nox-run prismlauncher" /></keybind>
    <keybind key="W-b"><action name="Execute" command="firefox" /></keybind>
    <keybind key="W-f"><action name="ToggleFullscreen" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
  </keyboard>
  <mouse>
    <default />
  </mouse>
  <!-- Apps launched from Nox Home open fullscreen and borderless on top of it -->
  <windowRules>
    <windowRule identifier="nox-home" serverDecoration="no" />
    <windowRule identifier="org.vinegarhq.Sober" serverDecoration="no">
      <action name="ToggleFullscreen" />
    </windowRule>
    <windowRule identifier="org.prismlauncher.PrismLauncher" serverDecoration="no">
      <action name="ToggleFullscreen" />
    </windowRule>
    <windowRule title="Minecraft*" serverDecoration="no">
      <action name="ToggleFullscreen" />
    </windowRule>
    <windowRule identifier="firefox" serverDecoration="no">
      <action name="ToggleFullscreen" />
    </windowRule>
  </windowRules>
</labwc_config>
