# Persistent data partition (created by nox-setup-home). If absent, /home stays in RAM.
LABEL=NOXHOME  /home  ext4  defaults,noatime,commit=60,nofail,x-systemd.device-timeout=5s  0 2
# Keep Wi-Fi passwords across reboots
/home/.nox/state/iwd  /var/lib/iwd  none  bind,nofail,x-systemd.requires-mounts-for=/home  0 0
