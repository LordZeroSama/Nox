[Unit]
Description=Nox OS - rescue password for the nox user (tty2-6 login)
After=systemd-sysusers.service
Before=systemd-user-sessions.service getty.target

[Service]
Type=oneshot
# Default password "nox" so a text console login is always possible (Ctrl+Alt+F2).
# Change it with "passwd" (reset at each boot since the system runs from RAM).
ExecStart=/bin/sh -c 'echo nox:nox | chpasswd'

[Install]
WantedBy=multi-user.target
